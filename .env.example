ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Envio de logs a New Relic (opcional). Sin URL no se envia nada.
# La clave sale de OTEL_EXPORTER_OTLP_HEADERS salvo que se defina LOG_SHIP_API_KEY.
# LOG_SHIP_URL=https://log-api.newrelic.com/log/v1
# LOG_SHIP_API_KEY=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=discordia_servicio
DATABASE_USER=discordia
DATABASE_PASSWORD=discordia
# "disable" en local, "require" contra Supabase
DATABASE_SSLMODE=disable

# El valor de ejemplo sirve solo para correr en local.
JWT_SECRET=secreto-jwt-solo-local

# RabbitMQ es obligatorio: sin el no arranca. Se levanta con el repo rabbit-mq.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Lo mismo, pero para cuando el servicio corre en el docker compose de este
# repo: desde un contenedor, localhost es el propio contenedor.
#   RABBITMQ_URL_DOCKER=amqp://guest:guest@host.docker.internal:5672/
RABBITMQ_URL_DOCKER=
# Firma billing.premium_updated; tiene que ser el mismo en identify y messaging
BILLING_EVENTS_HMAC_SECRET=secreto-billing-solo-local

# Mercado Pago (sandbox). Sin credenciales de prueba reales el servicio arranca,
# pero no se pueden crear cobros. Ver docs/testing.md.
MP_ACCESS_TOKEN=TEST-reemplazar-por-el-token-de-sandbox
# Clave secreta del webhook (Tus integraciones > Webhooks); valida x-signature
MP_WEBHOOK_SECRET=secreto-webhook-solo-local
# URL publica del web-client; MP vuelve a <url>/billing/return
CHECKOUT_RETURN_URL=http://localhost:3000
# Email del comprador de prueba (test_user_...@testuser.com); solo en sandbox
MP_TEST_PAYER_EMAIL=

# Solo en local: habilita POST /dev/billing/simulate-charge y simulate-expiry
# para demostrar renovaciones. No arranca si ENVIRONMENT=production.
BILLING_DEV_TOOLS=true
