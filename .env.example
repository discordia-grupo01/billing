ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# "disable" en local, "require" contra Supabase
DATABASE_SSLMODE=disable

JWT_SECRET=
RABBITMQ_URL=
# Firma billing.premium_updated; tiene que ser el mismo en identify y messaging
BILLING_EVENTS_HMAC_SECRET=

# Mercado Pago (sandbox)
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones > Webhooks); valida x-signature
MP_WEBHOOK_SECRET=
# URL publica del web-client; MP vuelve a <url>/billing/return
CHECKOUT_RETURN_URL=
# Email del comprador de prueba (test_user_...@testuser.com); solo en sandbox
MP_TEST_PAYER_EMAIL=

# Solo en local: habilita POST /dev/billing/simulate-charge y simulate-expiry
# para demostrar renovaciones. No arranca si ENVIRONMENT=production.
BILLING_DEV_TOOLS=false
